# =============================================================================
# Arbor — environment variables
# =============================================================================
# Copy this file to .env.local for local dev. For production, set every value
# marked REQUIRED in your Vercel project settings (Settings → Environment
# Variables → Production).
#
# Variable categories:
#   1. Supabase                 — REQUIRED for everything
#   2. App URL                  — REQUIRED
#   3. Outbound email (Resend)  — REQUIRED for invitations + magic links
#   4. Vercel Domains API       — REQUIRED for /agency/domain custom-domain feature
#   5. Arbor admin              — REQUIRED for billing operations
#   6. Arbor billing entity     — REQUIRED for invoice PDFs
#   7. Arbor legal identity     — REQUIRED before public launch (every legal doc references these)
#   8. Observability            — OPTIONAL
#
# Anything left unset falls back to a placeholder default that's safe for dev
# but WRONG for production. Audit this file end-to-end before going live.
# =============================================================================


# ── 1. Supabase ─────────────────────────────────────────────────────────────
# Get these from supabase.com → your project → Settings → API.
# The URL + anon key are safe to expose to the browser; the service role key
# is NOT — it bypasses every RLS policy and must stay server-side.

# REQUIRED. Public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# REQUIRED. Public. Anon key — RLS policies still apply.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# OPTIONAL. Project ref slug, used by some helper scripts.
SUPABASE_PROJECT_ID=your-project-id

# REQUIRED. Server-only. Service role key — bypasses RLS. Used by admin
# clients in server actions for cross-org operations (seeding, agency
# provisioning, billing generation, account deletion, etc.).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...


# ── 2. App URL ──────────────────────────────────────────────────────────────
# Where the app is hosted. Used to build absolute URLs in invitation emails,
# password-reset links, and OAuth redirects.

# REQUIRED. No trailing slash.
NEXT_PUBLIC_APP_URL=https://app.arbor.example


# ── 3. Outbound email (Resend) ──────────────────────────────────────────────
# Sign up at resend.com. Verify a sending domain (e.g. arbor.example) before
# going live — onboarding@resend.dev only works for testing and lands in spam.
#
# When RESEND_API_KEY is unset, sendEmail() degrades to console.warn and
# returns ok — the in-app invitation UI still works (admin can copy the
# accept URL manually) but no email is actually sent.

# REQUIRED for production. Server-only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# REQUIRED for production. Friendly-name <verified@your-domain.com> format.
# Falls back to "Arbor <onboarding@resend.dev>" which works for dev but
# Resend rate-limits it.
RESEND_FROM_EMAIL=Arbor <hello@arbor.example>


# ── 4. Vercel Domains API (custom-domain feature) ───────────────────────────
# Required for /agency/domain end-to-end verification. Without these, the
# UI still works and customers can save a pending domain — but verification
# fails until you set them. Get the token at vercel.com → Account Settings
# → Tokens. Get the project id at Vercel project → Settings → General.

# REQUIRED for custom-domain feature. Server-only.
VERCEL_API_TOKEN=

# REQUIRED for custom-domain feature.
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxx

# OPTIONAL. Only needed if your Vercel project is owned by a Team rather
# than a personal account.
VERCEL_TEAM_ID=team_xxxxxxxxxxxxx


# ── 5. Arbor admin allowlist ────────────────────────────────────────────────
# Comma-separated list of auth.users.id UUIDs who can perform Arbor-internal
# operations: mark invoices paid, manually trigger invoice generation, post
# status incidents (future). v1 substitute for a real Arbor-admin role.

# REQUIRED for production billing operations. Server-only. Comma-separated.
ARBOR_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000


# ── 6. Arbor billing entity (invoice PDFs) ──────────────────────────────────
# Rendered into the bill-from block on every invoice PDF generated at
# /api/agency/invoices/[id]/pdf. Customers see these values; make sure they
# match your incorporated entity and the bank account on the invoice.

# REQUIRED. Server-only.
ARBOR_BILLING_NAME=Raised Beef AI, LLC

# REQUIRED. Server-only. Use \n for line breaks in the PDF.
ARBOR_BILLING_ADDRESS=Raised Beef AI, LLC\n123 Main St\nWilmington, DE 19801

# REQUIRED. Server-only. Used for payment questions on the invoice.
ARBOR_BILLING_EMAIL=billing@arbor.example

# OPTIONAL. EIN / Tax ID printed on invoices for B2B customers that need it
# for vendor onboarding.
ARBOR_BILLING_EIN=

# OPTIONAL. Free-text payment instructions printed on every invoice. If
# unset, defaults to a generic "ACH preferred" message referencing
# ARBOR_BILLING_EMAIL.
ARBOR_BILLING_PAYMENT_INSTRUCTIONS=ACH preferred. Bank: First National. Routing: 000000000. Account: 0000000000. Reference invoice number with payment.


# ── 7. Arbor legal identity (legal docs + footer) ───────────────────────────
# Every page under /legal/* + /trust + the public footer reads from these.
# Have your attorney review the values before going live.

# REQUIRED. Your incorporated entity name as it appears on contracts.
ARBOR_LEGAL_NAME=Raised Beef AI, LLC

# REQUIRED. Used in Terms of Service governing-law clause.
ARBOR_LEGAL_JURISDICTION=Delaware, USA

# REQUIRED. Mailing address printed in every legal document.
ARBOR_LEGAL_ADDRESS=Raised Beef AI, LLC, 123 Main St, Wilmington, DE 19801

# REQUIRED. Inbox monitored by your privacy contact. Surfaced in Privacy
# Policy + DPA + cookie banner.
ARBOR_PRIVACY_EMAIL=privacy@arbor.example

# REQUIRED. Inbox for contract / legal questions. Surfaced in Terms of
# Service + DPA + footer.
ARBOR_LEGAL_EMAIL=legal@arbor.example

# REQUIRED. Inbox monitored for support tickets. Surfaced in SLA + Trust.
ARBOR_SUPPORT_EMAIL=support@arbor.example

# REQUIRED. Inbox monitored for security disclosures. Surfaced in AUP +
# Trust + incident-response runbook.
ARBOR_SECURITY_EMAIL=security@arbor.example

# OPTIONAL. Data Protection Officer inbox for GDPR. Defaults to
# privacy@arbor.app placeholder.
ARBOR_DPO_EMAIL=dpo@arbor.example


# ── 8. Observability ────────────────────────────────────────────────────────
# When set to "true", lib/observability.ts emits breadcrumb logs to
# console.debug. Useful when debugging error-reporting flows. Leave unset
# in production.

# OPTIONAL.
OBSERVABILITY_DEBUG=

# When you wire Sentry (or any equivalent) into lib/observability.ts,
# add SENTRY_DSN here. The wizard at `npx @sentry/wizard@latest -i nextjs`
# prompts for it.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx


# ── Notes ────────────────────────────────────────────────────────────────────
# - NEXT_PUBLIC_* variables are inlined into the JS bundle. NEVER prefix a
#   secret with NEXT_PUBLIC_.
# - On Vercel, set "Production / Preview / Development" scope explicitly per
#   variable. Service role keys typically only need Production.
# - To rotate a key without downtime: (a) add the new value as a SECOND
#   variable, (b) deploy code that reads either, (c) drop the old value, (d)
#   deploy code that reads only the new one.
